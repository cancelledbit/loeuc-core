{
  "id": "example.loeuc.range",
  "apiVersion": 1,
  "version": "1.0",
  "name": {
    "en": "Range estimate"
  },
  "summary": {
    "en": "Distance left from the battery level and a consumption you set."
  },
  "needsLocation": false,
  "telemetryHz": 1,
  "settings": [
    {
      "key": "km_per_percent",
      "label": {
        "en": "Distance per 1%"
      },
      "unit": "km",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 0.8
    },
    {
      "key": "reserve_km",
      "label": {
        "en": "Warn below"
      },
      "unit": "km",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 5
    }
  ],
  "tiles": [
    {
      "key": "range",
      "label": {
        "en": "Range left"
      },
      "unit": "km",
      "decimals": 1,
      "min": 0,
      "max": 500
    }
  ],
  "alerts": [
    {
      "key": "low_range",
      "text": {
        "en": "Range is low"
      },
      "persistence": "repeat"
    }
  ],
  "commands": [
    {
      "key": "horn",
      "label": {
        "en": "Horn when range runs out"
      },
      "action": "horn"
    }
  ]
}
