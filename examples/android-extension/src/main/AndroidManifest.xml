<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <!--
            The whole integration. The intent action is how LoEUC finds the service, the
            permission is what keeps anyone but LoEUC from binding it, and the meta-data points
            at the manifest the rider reviews before anything runs. Do not declare the
            permission itself: LoEUC does.
        -->
        <service
            android:name=".RangeExtensionService"
            android:exported="true"
            android:permission="pw.vasilevskiy.loeuc.permission.BIND_EXTENSION">
            <intent-filter>
                <action android:name="pw.vasilevskiy.loeuc.extension.BIND" />
            </intent-filter>
            <meta-data
                android:name="pw.vasilevskiy.loeuc.extension.MANIFEST"
                android:resource="@raw/loeuc_extension" />
        </service>
    </application>
</manifest>
